   <photoshop:TextLayers>
    <rdf:Bag>
     <rdf:li
      photoshop:LayerName="Helden von Andor - ich rufe euch! Helft uns! Das Land Hadria st"
      photoshop:LayerText="Helden von Andor - ich rufe euch! Helft uns! Das Land Hadria steht  kurz vor dem Untergang.  Kommt in den Norden  und rettet uns!  "/>
     <rdf:li
      photoshop:LayerName="Hadria ist in Gefahr?"
      photoshop:LayerText="Hadria ist in Gefahr?"/>
     <rdf:li
      photoshop:LayerName="Es herrschte der â€œKÃ¶nigsfriedenâ€ in Andor als Eara die Zauberin"
      photoshop:LayerText="Es herrschte der â€œKÃ¶nigsfriedenâ€ in Andor als Eara die Zauberin eine Vison hatte ... "/>
     <rdf:li
      photoshop:LayerName="So schnell sie konnte rannte Eara zur Rietburg. Sie musste zu K"
      photoshop:LayerText="So schnell sie konnte rannte Eara zur Rietburg. Sie musste zu KÃ¶nig Thorald. "/>
     <rdf:li
      photoshop:LayerName="Endlich erreichte sie den Thronsaal."
      photoshop:LayerText="Endlich erreichte sie den Thronsaal."/>
     <rdf:li
      photoshop:LayerName="Wir brauchen ein Schiff, mein KÃ¶nig und mÃ¼ssen Hadria zu Hilfe "
      photoshop:LayerText="Wir brauchen ein Schiff, mein KÃ¶nig und mÃ¼ssen Hadria zu Hilfe kommen. Bitte!"/>
     <rdf:li
      photoshop:LayerName="Ich hoffe Chada und Thorn sind ebenfalls an der Rietburg. "
      photoshop:LayerText="Ich hoffe Chada und Thorn sind ebenfalls an der Rietburg. "/>
     <rdf:li
      photoshop:LayerName="Ein Schiff? Wir Andori haben kaum Schiffe! Was du verlangst ist"
      photoshop:LayerText="Ein Schiff? Wir Andori haben kaum Schiffe! Was du verlangst ist nicht wenig, Zauberin. Aber gut. Ich gebe euch die Aldebaran.   "/>
     <rdf:li
      photoshop:LayerName="Dies ist das einzige Schiff, das ich erÃ¼brigen kann. Nehmt es o"
      photoshop:LayerText="Dies ist das einzige Schiff, das ich erÃ¼brigen kann. Nehmt es oder schwimmt!  "/>
     <rdf:li
      photoshop:LayerName="Herr, die  Aldebaran ist uralt. Ein Einmaster  ohne Waffen! "
      photoshop:LayerText="Herr, die  Aldebaran ist uralt. Ein Einmaster  ohne Waffen! "/>
     <rdf:li
      photoshop:LayerName="LAS   "
      photoshop:LayerText="LAS   "/>
     <rdf:li
